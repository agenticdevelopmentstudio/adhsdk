{
  "name": "agenticdevelopertoolkit",
  "version": "0.1.0",
  "description": "Agentic developer toolkit — shared React + TypeScript packages for persona chat, the ADH client, and the Agentic Cookbook family sites. pnpm monorepo.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agenticdevelopmentstudio/adhsdk.git"
  },
  "homepage": "https://github.com/agenticdevelopmentstudio/adhsdk#readme",
  "bugs": {
    "url": "https://github.com/agenticdevelopmentstudio/adhsdk/issues"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "build:types": "pnpm -r --if-present --workspace-concurrency=1 run build:types",
    "dev": "pnpm -r --parallel --if-present run dev",
    "test": "vitest run && pnpm -r --if-present run test",
    "lint": "python3 ../../tools/check_boundaries_test.py && python3 ../../tools/check_boundaries.py && pnpm -r --if-present run lint",
    "clean": "pnpm -r --if-present run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "jsdom": "^29.0.2",
    "tailwindcss": "^4.0.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "pnpm": {
    "overrides": {
      "vite": "^8.2.4",
      "esbuild": "^0.28.1",
      "dompurify": "^3.4.17",
      "@modelcontextprotocol/sdk": "^1.32.0",
      "body-parser@2": "^2.4.0",
      "brace-expansion@5": "^5.0.12",
      "js-yaml@3": "^3.15.2",
      "postcss": "^8.5.23",
      "source-map-js": "^1.2.2",
      "undici@7": "^7.30.1",
      "fast-uri": "^3.1.9",
      "ip-address": "^10.7.4",
      "qs": "^6.16.1",
      "next@15": "^15.5.28",
      "@vitest/mocker": "^4.1.12",
      "minimatch": "^11.0.1",
      "glob@>=9 <14.0.2": "^14.0.2",
      "@types/react": "19.2.18",
      "@bundled-es-modules/deepmerge>deepmerge": "-"
    },
    "allowNonAppliedPatches": true,
    "patchedDependencies": {
      "@redocly/openapi-core@1.34.20": "patches/@redocly__openapi-core@1.34.20.patch"
    }
  }
}
