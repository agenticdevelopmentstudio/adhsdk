{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true
  },
  // Tests are source, not surface: they need vitest and node types the
  // declaration build does not carry, and they must not emit into dist/.
  "exclude": ["src/__tests__", "src/**/*.test.ts", "src/**/*.test.tsx"]
}
