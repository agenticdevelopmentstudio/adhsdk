{
  "name": "@adh-sdk/adh-next-config",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The composition root every ADH site's next.config.ts calls. Derives the site from cwd, asserts its dependency declarations, and assembles the shared config.",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup && pnpm run build:types",
    "build:types": "tsc --emitDeclarationOnly -p tsconfig.build.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@adh-sdk/adh-registry": "workspace:*",
    "@adh-sdk/next-env": "workspace:*",
    "@adh-sdk/next-headers": "workspace:*",
    "@adh-sdk/next-preflight": "workspace:*",
    "@adh-sdk/themes": "workspace:*"
  },
  "peerDependencies": {
    "next": "^16.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "next": "16.4.3",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^4.1.4"
  }
}
