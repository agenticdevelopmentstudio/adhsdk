.DS_Store
.claude/worktrees/
.claude/settings.local.json
.env
.superpowers/

# Node / Next.js / OpenNext / Wrangler build outputs
# packages/web/node_modules/**
node_modules/
packages/web/**/node_modules
packages/web/**/dist

websites/**/node_modules
websites/**/dist
websites/**/package-lock.json
websites/**/.next

# .next/
# .open-next/
# .wrangler/
*.tsbuildinfo
*.log

# pnpm workspace + package builds
packages/*/dist/

# generated by packages/web/packages/themes/scripts/build-theme-data.mjs
# packages/web/packages/themes/src/theme-data.ts

.vercel

# Xcode per-user state
**/xcuserdata/
*.xcuserstate

# Xcode build output (xcodebuild -derivedDataPath ./build)
packages/apple/**/build/

# Python bytecode from tools/
__pycache__/

# From adhsdk's ignore list. Its `packages/web/packages/themes/` entry is
# deliberately not here: it hid a package that had left ATK for this repo, and
# `themes` lives here again. Its blanket `Package.resolved` / xcworkspace
# xcshareddata ignores are not here either: this repo commits the workspace's
# resolved SwiftPM pins so every checkout builds the same dependency graph.
.worktrees/
.turbo/
.next/
next-env.d.ts
.pnpm-store/
**/.build/
DerivedData/
*.pyc
graphify-out/
.claude/scheduled_tasks.lock

# Generated code is never committed: each file is rebuilt by its generator.
# Specs and other inputs (openapi*.json, the hand-written routes.generated.ts
# that merges the per-site shares) stay tracked.
packages/terminal/src/apt_terminal/generated/
packages/apple/AgenticDeveloperHubClient/Sources/Generated/
packages/apple/AgenticDeveloperHubClient/AuthSources/Generated/
packages/web/packages/adh-api-types/src/schema.ts
packages/web/packages/crud/src/generated/
packages/web/packages/api-explorer/src/generated/
packages/web/packages/adh/src/help/content.generated.ts
packages/web/packages/adh-registry/src/sites/routes.*.generated.ts
